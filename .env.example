# Copy this file to ".env" (same folder) and fill in your real value. ".env" is git-ignored; this example is not.
# Plain KEY=value lines: no quotes, and double any backslash in a value.
DB_PASSWORD=your-mysql-password
# Must be the EXACT same value as INTERNAL_SERVICE_API_KEY in ProductService's own .env.
INTERNAL_SERVICE_API_KEY=change-this-service-key
# Optional: Gmail address + 16-character App Password used to email storefront sign-in codes (same as Bankapplication).
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-gmail-app-password
# Optional, local development only: log sign-in codes when an email can't be sent. Never true in production.
CUSTOMER_LOGIN_LOG_CODES=false

# Optional: restock / price-drop email job (see StockAlertService). Defaults: on, every 10 minutes.
# ALERTS_ENABLED=true
# ALERTS_INTERVAL_MS=600000
# Link added to those emails, e.g. where the shop is hosted.
# SHOP_URL=http://localhost:8083/shop.html
